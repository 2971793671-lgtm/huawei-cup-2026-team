# Python and local environments
__pycache__/
*.py[cod]
.venv/
venv/
env/.conda/
.pytest_cache/
.ruff_cache/

# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key

# Private transcripts, unreleased prompts and local-only research material
local/*
!local/README.md

# Large or sensitive data: keep manifests in Git, not raw files
data/raw/*
data/interim/*
data/processed/*
data/cache/*
data/origin/*
!data/origin/README.md
models/*.pt
models/*.pth
models/*.onnx
models/*.pkl
models/*.joblib
experiments/runs/*/artifacts/

# LaTeX build products
paper/*.aux
paper/*.bbl
paper/*.bcf
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.lof
paper/*.log
paper/*.lot
paper/*.out
paper/*.run.xml
paper/*.synctex.gz
paper/*.toc
paper/build/
paper/*.pdf
paper/*.xdv
paper/final/*
!paper/final/README.md

# Imported template build products (the checked-in example PDFs remain tracked)
paper/template/*.aux
paper/template/*.bbl
paper/template/*.bcf
paper/template/*.blg
paper/template/*.fdb_latexmk
paper/template/*.fls
paper/template/*.lof
paper/template/*.log
paper/template/*.lot
paper/template/*.out
paper/template/*.run.xml
paper/template/*.synctex.gz
paper/template/*.toc

# Local IDE and OS files
.idea/
.vscode/settings.json
.DS_Store
Thumbs.db

# Temporary release files
deliverables/staging/

# Local problem files may contain unreleased or modified source material
problem/*
!problem/README.md
